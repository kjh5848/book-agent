# ============================================================
# CH07 RAG Q&A 엔진 — 환경 변수 템플릿
# .env.example을 복사하여 .env 파일로 저장한 뒤 값을 설정하십시오.
# cp .env.example .env
# ============================================================

# --- LLM 설정 (로컬 Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:1.5b

# --- 임베딩 모델 설정 ---
# CH06에서 사용한 것과 동일한 임베딩 모델을 지정해야 합니다.
EMBED_MODEL=nomic-embed-text

# --- ChromaDB 설정 ---
# CH06에서 생성한 chroma_db 디렉토리 경로를 지정합니다.
CHROMA_PERSIST_DIR=./data/chroma_db
COLLECTION_NAME=rag_docs

# --- 검색 설정 ---
# 유사도 검색 시 반환할 문서 수
RETRIEVER_K=3
