# =============================================================
# .env.example
# AI 업무 비서 구축: RAG + MCP 실전 가이드 - 4장 베이스 시스템 확보
#
# 사용법:
#   cp .env.example .env
#   # .env 파일에서 필요한 값을 수정합니다.
#
# 주의: .env 파일은 절대 Git에 커밋하지 마십시오.
# =============================================================

# PostgreSQL 연결 정보
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=rag_db
POSTGRES_USER=rag_user
POSTGRES_PASSWORD=rag_password
