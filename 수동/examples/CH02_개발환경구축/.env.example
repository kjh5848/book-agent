# .env.example
# AI 업무 비서 구축: RAG + MCP 실전 가이드 — 환경 변수 템플릿
#
# 사용 방법:
#   1. 이 파일을 .env 로 복사합니다.
#      cp .env.example .env
#   2. .env 파일을 열어 필요한 값을 변경합니다.
#      (대부분의 기본값을 그대로 사용해도 됩니다.)
#   3. .env 파일은 절대 Git에 커밋하지 마십시오. (.gitignore에 포함됨)
#
# 이 책의 모든 서비스는 무료이며 외부 API 키가 필요하지 않습니다.

# =============================================================================
# LLM Provider 설정
# =============================================================================
# 사용할 LLM 제공자를 지정합니다.
# 현재 지원: ollama (로컬 전용)
# 향후 확장 가능: openai, anthropic
LLM_PROVIDER=ollama

# Ollama 서버 주소 (기본값: 로컬)
OLLAMA_BASE_URL=http://localhost:11434

# 사용할 LLM 모델명 (올라마에 다운로드된 모델명과 일치해야 합니다)
# 권장: deepseek-r1 (전체 크기) 또는 deepseek-r1:7b (RAM 16GB 미만 환경)
OLLAMA_MODEL=deepseek-r1

# 이미지 분석용 Vision LLM (10장에서 사용)
OLLAMA_VISION_MODEL=llava

# =============================================================================
# PostgreSQL 설정
# =============================================================================
# docker-compose.yml의 environment 값과 일치해야 합니다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=company_db
POSTGRES_USER=admin
# 실제 운영 환경에서는 반드시 강력한 비밀번호로 변경하십시오.
POSTGRES_PASSWORD=changeme

# =============================================================================
# ChromaDB 벡터 데이터베이스 설정 (6장부터 사용)
# =============================================================================
# 벡터 데이터가 저장될 로컬 디렉토리 경로
CHROMA_PERSIST_DIR=./chroma_data

# ChromaDB 컬렉션 이름 (벡터 DB 안의 '테이블' 개념)
CHROMA_COLLECTION=company_docs

# =============================================================================
# FastAPI CRUD 서버 설정 (4장부터 사용)
# =============================================================================
# rag-infra docker-compose로 구동되는 FastAPI 서버 주소
CRUD_API_BASE_URL=http://localhost:8000
