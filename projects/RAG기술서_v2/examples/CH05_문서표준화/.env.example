# CH05 사내 문서 표준화 환경 변수 설정
# 이 파일을 복사하여 .env 파일을 만드십시오: cp .env.example .env

# -------------------------------------------------------
# 문서 디렉토리 설정
# -------------------------------------------------------
# 수집할 문서가 있는 디렉토리 경로 (기본값: data/sample_docs)
DOCS_DIR=data/sample_docs

# -------------------------------------------------------
# 출력 디렉토리 설정
# -------------------------------------------------------
# 정규화된 Markdown 파일 저장 경로 (기본값: outputs/markdown)
NORMALIZED_OUTPUT_DIR=outputs/markdown

# 메타데이터 JSON 파일 저장 경로 (기본값: outputs/metadata)
METADATA_OUTPUT_DIR=outputs/metadata
