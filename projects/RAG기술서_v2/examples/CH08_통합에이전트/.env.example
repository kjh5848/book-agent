# ============================================================
# CH08 통합 에이전트 — 환경 변수 템플릿
# 이 파일을 복사하여 .env 파일로 사용하십시오.
#   cp .env.example .env
# ============================================================

# ---- Ollama 설정 ----
# Ollama 서버가 실행 중이어야 합니다. (ollama serve)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1

# ---- PostgreSQL 설정 ----
# docker-compose up -d 로 구동하면 아래 기본값을 그대로 사용합니다.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=connecthr
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# ---- ChromaDB 설정 ----
# CH06에서 구축한 벡터 DB 경로를 지정합니다.
# CH06 예제를 먼저 실행하면 이 경로에 데이터가 생성됩니다.
CHROMA_PERSIST_DIR=./data/chroma_db
CHROMA_COLLECTION=company_docs

# ---- 에이전트 동작 설정 ----
# RAG 검색 시 반환할 최대 문서 수
RAG_TOP_K=3
# 에이전트 최대 반복 횟수 (무한 루프 방지)
AGENT_MAX_ITERATIONS=8
