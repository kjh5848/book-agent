# CH09 LangChain 최종 연결 — 환경 변수 템플릿
# 이 파일을 .env로 복사한 후 값을 설정하십시오.
# cp .env.example .env

# --- Ollama 설정 ---
OLLAMA_MODEL=deepseek-r1
OLLAMA_BASE_URL=http://localhost:11434

# --- PostgreSQL 설정 ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=connecthr
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# --- ChromaDB 설정 ---
CHROMA_PERSIST_DIR=./data/chroma_db

# --- 운영 설정 ---
# LLM 응답 최대 대기 시간 (초)
LLM_TIMEOUT=30
# LLM 호출 최대 재시도 횟수
LLM_MAX_RETRIES=3
# 캐시 유지 시간 (초)
CACHE_TTL=300
# 로그 레벨 (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO
# 로그 파일 경로
LOG_FILE=./outputs/app.log
# 요청당 최대 토큰 수
MAX_TOKENS_PER_REQUEST=2000
