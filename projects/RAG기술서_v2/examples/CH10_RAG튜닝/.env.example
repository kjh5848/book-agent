# CH10 RAG 시스템 튜닝 환경 변수 템플릿
# 이 파일을 복사하여 .env로 저장한 뒤 값을 입력하십시오.
# cp .env.example .env

# ── Ollama 설정 ─────────────────────────────────────────────
# Ollama 서버 주소 (기본값: 로컬 실행)
OLLAMA_BASE_URL=http://localhost:11434

# 기본 LLM 모델 (텍스트 생성용)
OLLAMA_MODEL=deepseek-r1

# 비전 LLM 모델 (이미지 설명 생성용)
# 설치 명령어: ollama pull llava
OLLAMA_VISION_MODEL=llava

# ── ChromaDB 설정 ────────────────────────────────────────────
# 벡터 DB 저장 경로 (상대 경로 가능)
CHROMA_PERSIST_DIR=./outputs/chroma_db

# ChromaDB 컬렉션 이름
CHROMA_COLLECTION=connecthr_docs

# ── ReRanker 설정 ────────────────────────────────────────────
# Cross-Encoder 모델 이름 (HuggingFace Hub에서 자동 다운로드)
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ── 임베딩 모델 설정 ─────────────────────────────────────────
# 한국어 지원 다국어 임베딩 모델
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ── RAG 검색 설정 ────────────────────────────────────────────
# 기본 검색 결과 수 (k값)
RAG_TOP_K=3
