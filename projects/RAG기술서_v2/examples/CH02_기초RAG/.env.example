# CH02 기초 RAG — 환경 변수 템플릿
# 사용 방법: cp .env.example .env 후 값을 채우십시오.
# 주의: 실제 키나 비밀번호를 이 파일(.env.example)에 입력하지 마십시오.

# --- Ollama 설정 ---
# Ollama 로컬 서버 주소 (기본값: http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# 사용할 LLM 모델 이름
# 다운로드 방법: ollama pull deepseek-r1
# 메모리 부족 시 소형 모델 사용: deepseek-r1:1.5b
OLLAMA_MODEL=deepseek-r1
