# CH06 환경 변수 설정
# 이 파일을 복사하여 .env 파일을 생성하십시오: cp .env.example .env

# Ollama 서버 설정
# Ollama가 설치되어 있지 않거나 연결할 수 없으면 sentence-transformers를 자동으로 사용합니다.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# ChromaDB 저장 경로
# 상대 경로 또는 절대 경로 모두 사용 가능합니다.
CHROMA_PERSIST_DIR=./outputs/chroma_db
