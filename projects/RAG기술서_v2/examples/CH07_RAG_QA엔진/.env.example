# CH07 RAG Q&A 엔진 환경 변수 템플릿
# 이 파일을 .env로 복사한 뒤 필요한 값을 수정하십시오.
# cp .env.example .env

# ─────────────────────────────────────────────
# Ollama LLM 설정
# ─────────────────────────────────────────────
# 사용할 LLM 모델 이름 (ollama pull deepseek-r1 으로 다운로드)
OLLAMA_MODEL=deepseek-r1

# Ollama 서버 주소 (로컬 기본값)
OLLAMA_BASE_URL=http://localhost:11434

# 임베딩 모델 (ollama pull nomic-embed-text 으로 다운로드)
# Ollama 미연결 시 sentence-transformers로 자동 대체됩니다.
OLLAMA_EMBED_MODEL=nomic-embed-text

# ─────────────────────────────────────────────
# ChromaDB 설정
# ─────────────────────────────────────────────
# ChromaDB 파일 저장 경로 (상대 경로 권장)
CHROMA_PERSIST_DIR=./data/chroma_db

# 검색 대상 컬렉션 이름
CHROMA_COLLECTION=connecthr_docs

# ─────────────────────────────────────────────
# RAG 검색 설정
# ─────────────────────────────────────────────
# 유사도 검색 결과 수 (top-k)
# 값이 작을수록 정확도 향상, 너무 크면 노이즈 증가
RAG_TOP_K=3
