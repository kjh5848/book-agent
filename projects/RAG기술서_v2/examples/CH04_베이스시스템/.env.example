# ============================================================
# 커넥트HR 베이스 시스템 환경 변수 템플릿
# 챕터 4: 베이스 시스템 확보
#
# 사용 방법:
#   cp .env.example .env
#   .env 파일을 열어 실제 값을 입력하십시오.
#   .env 파일은 절대 Git에 커밋하지 마십시오.
# ============================================================

# PostgreSQL 연결 정보
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=connecthr
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# FastAPI 서버 주소 (CRUD API)
FASTAPI_BASE_URL=http://localhost:8000

# FastAPI 서버 실행 포트
FASTAPI_PORT=8000
