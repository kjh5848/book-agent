# =============================================================
# CH03 개발 환경 구축 - 환경 변수 템플릿
# =============================================================
# 이 파일을 복사하여 .env 파일을 만든 후 값을 입력하십시오.
#   cp .env.example .env
#
# 주의: .env 파일은 절대 git에 커밋하지 마십시오.
# =============================================================

# --- Ollama 설정 ---
# 로컬에서 실행 중인 Ollama 서버 주소
OLLAMA_BASE_URL=http://localhost:11434

# 기본 LLM 모델 (deepseek-r1 또는 deepseek-r1:1.5b)
# 메모리가 부족한 경우 deepseek-r1:1.5b 로 변경하십시오.
OLLAMA_MODEL=deepseek-r1

# 이미지 처리용 Vision 모델 (CH10에서 사용)
OLLAMA_VISION_MODEL=llava

# --- PostgreSQL 설정 ---
# docker-compose.yml 기본값과 일치시키십시오.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=connecthr
POSTGRES_USER=admin
POSTGRES_PASSWORD=password

# --- ChromaDB 설정 ---
# 벡터 DB 데이터 저장 경로 (CH06부터 사용)
CHROMA_PERSIST_DIR=./outputs/chroma_db

# --- FastAPI CRUD 서버 (CH04부터 사용) ---
FASTAPI_BASE_URL=http://localhost:8000
