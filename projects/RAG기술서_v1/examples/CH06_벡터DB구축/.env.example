# LLM Provider 설정 (ollama 또는 openai)
LLM_PROVIDER=ollama

# Vision LLM 모델명 (--vision 플래그 사용 시)
# Ollama: llava:7b, llava:13b / OpenAI: gpt-4o, gpt-4o-mini
LLM_MODEL_NAME=llava:7b

# Ollama 설정
OLLAMA_BASE_URL=http://localhost:11434

# OpenAI 설정 (필요 시 주석 해제)
# OPENAI_API_KEY=sk-proj-...

# 임베딩 모델
EMBED_MODEL=nomic-embed-text

# 쿼리 LLM 모델명 (scripts/query.py 사용 시)
# 저사양: deepseek-r1:1.5b / 고사양: qwen2.5:7b, gemma3:4b
CHAT_MODEL=deepseek-r1:1.5b

# ChromaDB 설정
CHROMA_PERSIST_DIR=./outputs/chroma_db
COLLECTION_NAME=rag_docs
