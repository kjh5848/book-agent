# CH03 환경 변수 템플릿
# 이 파일을 .env로 복사한 후 값을 설정하십시오.
# cp .env.example .env

# Ollama 서버 주소 (기본값: 로컬)
OLLAMA_BASE_URL=http://localhost:11434

# LLM 모델명 (ollama pull deepseek-r1:1.5b 로 다운로드)
# 사양이 낮은 환경에서는 deepseek-r1:1.5b 를 사용하십시오.
# 고사양 환경에서는 deepseek-r1:7b 또는 deepseek-r1:8b 를 사용할 수 있습니다.
OLLAMA_MODEL=deepseek-r1:1.5b

# 임베딩 모델명 (ollama pull nomic-embed-text 로 다운로드)
# 03_rag_preview.py 와 04_rag_reasoning.py 에서 사용합니다.
EMBED_MODEL=nomic-embed-text
