# ====================================================
# CH10 RAG 튜닝 - 환경 변수 설정
# .env.example을 복사하여 .env로 저장 후 값을 입력하십시오.
# cp .env.example .env
# ====================================================

# --- LLM 제공자 설정 ---
# 기본값: ollama (로컬 실행)
LLM_PROVIDER=ollama

# Ollama 설정 (LLM_PROVIDER=ollama 인 경우)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:8b

# OpenAI 설정 (LLM_PROVIDER=openai 인 경우)
# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-your-api-key-here
# OPENAI_MODEL=gpt-4o-mini

# --- 임베딩 모델 설정 ---
EMBEDDING_MODEL=jhgan/ko-sroberta-multitask

# --- ChromaDB 설정 ---
# ChromaDB 없이 인메모리 샘플 모드로 실행하려면 USE_SAMPLE_DATA=true
USE_SAMPLE_DATA=true
CHROMA_PERSIST_DIR=./data/chroma_db

# --- 평가 설정 ---
# RAGAS 사용 여부 (requires: pip install ragas)
USE_RAGAS=false

# --- 실험 출력 경로 ---
EXPERIMENT_OUTPUT_DIR=./outputs
